# ==========================================
# ENVIRONMENT CONFIGURATION - OLO FINTEL
# ==========================================

NODE_ENV="development"
PORT=3000

# PostgreSQL Connection Strings
# For local Docker or Supabase deployments
DATABASE_URL="postgresql://postgres:postgres_password@postgres:5432/olofintel?schema=public"
DIRECT_URL="postgresql://postgres:postgres_password@postgres:5432/olofintel?schema=public"

# JSON Web Tokens (Security & Auth)
JWT_SECRET="olo-fintel-secret-key-2026-luanda"
JWT_REFRESH_SECRET="olo-fintel-refresh-secret-key-2026-luanda"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Config (For BullMQ async queues)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Supabase Client Integration (Storage Bucket)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role"
STORAGE_BUCKET="olo-documents-bucket"

# Artificial Intelligence (Gemini API is priority)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="your-openai-api-key"
CLAUDE_API_KEY="your-anthropic-key"

# Email Integration
EMAIL_PROVIDER="sendgrid"
EMAIL_FROM="no-reply@olofintel.ao"

# Applications Routing URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"
